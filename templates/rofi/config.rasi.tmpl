/* Generated by desktop. Change themes/ or templates/, not this file. */

configuration {
    modi: "drun,run";
    show-icons: true;
    font: "${FONT_MONO} 11";
    terminal: "kitty";
    drun-display-format: "{name}";
    matching: "normal";
    sort: true;
    matching: "normal";
    sort: true;
}

* {
    bg:         rgba ( ${BG_RGB}, 100% );
    bg-alt:     ${BG_RAISED};
    fg:         ${FG};
    fg-muted:   ${FG_MUTED};
    accent:     ${ACCENT};
    border:     ${BORDER};

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 540px;
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 16px;
    padding: 14px;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    border-radius: 10px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    border-radius: 10px;
    background-color: @bg-alt;
    text-color: @fg;
    children: [ prompt, entry ];
}

entry {
    text-color: @fg;
    placeholder: "Search";
    placeholder-color: @fg-muted;
    cursor: @accent;
}

listview {
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: ${BLACK};
}

element-icon {
    size: 1.6em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
