# Generated by desktop. Change themes/ or templates/, not this file.

general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
    noise = 0.01
    contrast = 0.9
    brightness = 0.6
    color = rgb(${BG_RGB})
}

# Clock
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb(${FG_RGB})
    font_size = 110
    font_family = ${FONT_MONO}
    position = 0, 120
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %B %d"
    color = rgb(${FG_MUTED_RGB})
    font_size = 18
    font_family = ${FONT_MONO}
    position = 0, 30
    halign = center
    valign = center
}

# Password field
input-field {
    monitor =
    size = 300, 56
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.4
    dots_center = true
    dots_fade_time = 200
    outer_color = rgb(${ACCENT_RGB})
    inner_color = rgba(${BG_ALT_RGB},0.85)
    font_color = rgb(${FG_RGB})
    font_family = ${FONT_MONO}
    fade_on_empty = true
    placeholder_text = <i>Password</i>
    check_color = rgb(${GREEN_RGB})
    fail_color = rgb(${RED_RGB})
    fail_text = <i>Wrong password</i>
    capslock_color = rgb(${YELLOW_RGB})
    position = 0, -90
    halign = center
    valign = center
}
