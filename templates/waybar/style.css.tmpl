/* Generated by desktop. Change themes/ or templates/, not this file. */
@define-color base     ${BG};
@define-color mantle   ${BG_ALT};
@define-color surface0 ${BG_RAISED};
@define-color surface1 ${BORDER};
@define-color text     ${FG};
@define-color subtext  ${FG_MUTED};
@define-color accent   ${ACCENT};
@define-color green    ${GREEN};
@define-color yellow   ${YELLOW};
@define-color red      ${RED};

* {
    border: none;
    border-radius: 0;
    min-height: 0;
    font-family: "${FONT_ICON}", "${FONT_MONO}", "Font Awesome 6 Free";
    font-size: 13px;
    font-weight: 500;
}

window#waybar {
    background: transparent;
    color: @text;
}

#workspaces,
#clock,
#battery,
#network,
#pulseaudio,
#bluetooth,
#tray {
    background: alpha(@base, 0.85);
    color: @text;
    margin: 4px 4px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid alpha(@surface0, 0.9);
    transition: background-color 200ms ease, color 200ms ease;
}

#workspaces { padding: 0 4px; }

#workspaces button {
    padding: 0 9px;
    margin: 4px 2px;
    border-radius: 8px;
    background: transparent;
    color: @subtext;
    transition: all 200ms ease;
}
#workspaces button:hover { background: @surface0; color: @text; }
#workspaces button.active { background: @accent; color: @mantle; }
#workspaces button.urgent { background: @red; color: @mantle; }

#clock { font-weight: 600; letter-spacing: 0.3px; padding: 0 18px; }

#battery.warning { color: @yellow; }
#battery.critical { color: @red; }
#battery.charging,
#battery.plugged { color: @green; }
#network.disconnected,
#pulseaudio.muted { color: @subtext; }

#tray { padding: 0 10px; }
#tray > .passive { -gtk-icon-effect: dim; }
#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background: alpha(@red, 0.3);
}

tooltip {
    background: @base;
    border: 1px solid @surface1;
    border-radius: 10px;
}
tooltip label { color: @text; }
